---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="wrap nf">
    <p class="mono code">404 · path not found</p>
    <h1>Nothing lives here.</h1>
    <p>The page may have moved, or the link might be mistyped.</p>
    <a class="btn primary" href="/">← Back to the workspace</a>
  </section>
</Base>

<style>
  .nf { padding-block: 8rem; }
  .code { color: var(--accent); }
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: 1rem 0; }
  p:not(.code) { color: var(--ink-soft); margin-bottom: 2rem; }
</style>
